<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="16dp">

    <!-- Active State: 4x3 Full -->
    <LinearLayout
        android:id="@+id/widget_main_full_active"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- Top Header: Exercise Name, Routine & Chronometer -->
        <LinearLayout
            android:id="@+id/widget_main_full_active_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_main_full_active_exercise"
                style="@style/WidgetPrimaryText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Deadlift"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical|end"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_main_full_active_routine"
                    style="@style/WidgetSecondaryText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Lower B · "
                    android:textSize="12sp" />

                <Chronometer
                    android:id="@+id/widget_main_full_active_elapsed"
                    style="@style/WidgetSecondaryText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/hevynt_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Subtitle: Set 1 of 3 -->
        <TextView
            android:id="@+id/widget_main_full_active_set_info"
            style="@style/WidgetSecondaryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Set 1 of 3"
            android:textSize="13sp" />

        <!-- Rest Countdown / READY Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Chronometer
                android:id="@+id/widget_main_full_active_timer"
                style="@style/WidgetRestCountdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="02:41" />

            <ImageView
                android:id="@+id/widget_main_full_active_ready_img"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:adjustViewBounds="true"
                android:contentDescription="Set ready"
                android:scaleType="fitStart"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_main_full_active_rest_label"
                style="@style/WidgetSecondaryText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:gravity="end|center_vertical"
                android:text="Rest"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/widget_main_full_active_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progress="65"
            android:progressDrawable="@drawable/widget_progress_bar" />

        <!-- Stepper Controls Row: Weight and Reps -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Weight Stepper -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/widget_btn_weight_minus"
                    style="@style/WidgetStepperValue"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/widget_stepper_button_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="−"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/widget_weight_value"
                        style="@style/WidgetStepperValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="100" />

                    <TextView
                        style="@style/WidgetStepperUnit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="kg" />
                </LinearLayout>

                <Button
                    android:id="@+id/widget_btn_weight_plus"
                    style="@style/WidgetStepperValue"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/widget_stepper_button_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="+"
                    android:textSize="20sp" />
            </LinearLayout>

            <!-- Reps Stepper -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/widget_btn_reps_minus"
                    style="@style/WidgetStepperValue"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/widget_stepper_button_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="−"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/widget_reps_value"
                        style="@style/WidgetStepperValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="5" />

                    <TextView
                        style="@style/WidgetStepperUnit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="reps" />
                </LinearLayout>

                <Button
                    android:id="@+id/widget_btn_reps_plus"
                    style="@style/WidgetStepperValue"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/widget_stepper_button_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="+"
                    android:textSize="20sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Spacer weight to push buttons to bottom in 4x3 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Action Buttons Row: Skip rest (or +30 s) & Complete set -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/widget_main_full_btn_left"
                style="@style/WidgetSkipButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:text="Skip rest" />

            <Button
                android:id="@+id/widget_main_full_btn_right"
                style="@style/WidgetCompleteButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1.5"
                android:clickable="true"
                android:focusable="true"
                android:text="Complete set" />
        </LinearLayout>
    </LinearLayout>

    <!-- Idle State: 4x3 Full -->
    <LinearLayout
        android:id="@+id/widget_main_full_idle"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Header: Routine Title & Count -->
        <LinearLayout
            android:id="@+id/widget_main_full_idle_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_main_full_idle_title_img"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:adjustViewBounds="true"
                android:contentDescription="Routine title"
                android:scaleType="fitStart" />

            <TextView
                android:id="@+id/widget_main_full_idle_title"
                style="@style/WidgetHugeDotoText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="LOWER B"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_main_full_idle_count"
                style="@style/WidgetSecondaryText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6 exercises"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Preview Exercises List -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_main_full_idle_preview_1"
                style="@style/WidgetSecondaryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="• Deadlift (3 sets)"
                android:textColor="@color/hevynt_text_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/widget_main_full_idle_preview_2"
                style="@style/WidgetSecondaryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="• Leg press (3 sets)"
                android:textColor="@color/hevynt_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_main_full_idle_preview_3"
                style="@style/WidgetSecondaryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="• Leg curl (3 sets)"
                android:textColor="@color/hevynt_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Prominent Red Start Button -->
        <Button
            android:id="@+id/widget_main_full_idle_start_btn"
            style="@style/WidgetCompleteButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/widget_complete_button_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Start workout"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
