<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:paddingHorizontal="10dp"
    android:paddingVertical="6dp" >

    <LinearLayout
        android:id="@+id/widget_compact_idle"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical" >

        <TextView
            android:id="@+id/widget_compact_idle_title"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/doto_variable"
            android:gravity="bottom"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="UPPER A"
            android:textColor="@color/hevynt_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_compact_idle_action"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_action_background"
            android:fontFamily="@font/doto_variable"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingHorizontal="7dp"
            android:text="OPEN WORKOUT"
            android:textColor="@color/hevynt_accent"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_compact_active"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:visibility="gone" >

        <TextView
            android:id="@+id/widget_compact_active_exercise"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/doto_variable"
            android:gravity="bottom"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="Incline DB Press"
            android:textColor="@color/hevynt_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="2dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal" >

            <TextView
                android:id="@+id/widget_compact_active_load"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="30 kg × 10"
                android:textColor="@color/hevynt_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_compact_complete"
                android:layout_width="34dp"
                android:layout_height="match_parent"
                android:background="@drawable/widget_action_background"
                android:fontFamily="monospace"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="✓"
                android:textColor="@color/hevynt_accent"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_compact_rest"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:visibility="gone" >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal" >

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fontFamily="@font/doto_variable"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:text="REST"
                android:textColor="@color/hevynt_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Chronometer
                android:id="@+id/widget_compact_rest_timer"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:fontFamily="monospace"
                android:gravity="center_vertical|end"
                android:includeFontPadding="false"
                android:textColor="@color/hevynt_accent"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="3dp"
            android:layout_weight="1"
            android:orientation="horizontal" >

            <TextView
                android:id="@+id/widget_compact_subtract"
                style="@style/WidgetControlText"
                android:text="−15" />

            <TextView
                android:id="@+id/widget_compact_skip"
                style="@style/WidgetControlText"
                android:layout_marginHorizontal="4dp"
                android:text="SKIP" />

            <TextView
                android:id="@+id/widget_compact_add"
                style="@style/WidgetControlText"
                android:text="+15" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>