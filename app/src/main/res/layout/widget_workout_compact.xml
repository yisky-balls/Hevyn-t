<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:paddingHorizontal="10dp"
    android:paddingVertical="6dp" >

    <LinearLayout
        android:id="@+id/widget_compact_idle"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical" >

        <TextView
            android:id="@+id/widget_compact_idle_title"
            style="@style/WidgetPrimaryText"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/workout_widget_preview_routine" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal" >

            <TextView
                android:id="@+id/widget_compact_idle_metadata"
                style="@style/WidgetSecondaryText"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/workout_widget_preview_exercises" />

            <TextView
                android:id="@+id/widget_compact_idle_action"
                style="@style/WidgetCompactActionText"
                android:text="@string/workout_widget_open" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_compact_active"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone" >

        <TextView
            android:id="@+id/widget_compact_active_routine"
            style="@style/WidgetPrimaryText"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/workout_widget_preview_routine" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal" >

            <TextView
                android:id="@+id/widget_compact_active_progress"
                style="@style/WidgetSecondaryText"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/workout_widget_preview_progress" />

            <Chronometer
                android:id="@+id/widget_compact_active_timer"
                style="@style/WidgetTimerText"
                android:layout_width="wrap_content" />

            <TextView
                android:id="@+id/widget_compact_continue"
                style="@style/WidgetCompactActionText"
                android:layout_marginStart="6dp"
                android:text="@string/workout_widget_continue_compact" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
