<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:paddingHorizontal="14dp"
    android:paddingVertical="10dp" >

    <LinearLayout
        android:id="@+id/widget_main_idle"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical" >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal" >

            <TextView style="@style/WidgetHeaderText" android:text="@string/workout_widget_brand" />

            <TextView
                style="@style/WidgetLabelText"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:gravity="end"
                android:text="@string/workout_widget_likely_next" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_main_idle_routine"
            style="@style/WidgetPrimaryText"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/workout_widget_preview_routine" />

        <TextView
            android:id="@+id/widget_main_idle_metadata"
            style="@style/WidgetSecondaryText"
            android:layout_height="0dp"
            android:layout_marginTop="2dp"
            android:layout_weight="1"
            android:gravity="top"
            android:text="@string/workout_widget_preview_metadata" />

        <TextView
            android:id="@+id/widget_main_idle_action"
            style="@style/WidgetActionText"
            android:text="@string/workout_widget_open" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_main_active"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone" >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal" >

            <TextView style="@style/WidgetHeaderText" android:text="@string/workout_widget_brand" />

            <TextView
                style="@style/WidgetActiveLabelText"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:gravity="end"
                android:text="@string/workout_widget_active" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_main_active_routine"
            style="@style/WidgetPrimaryText"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/workout_widget_preview_routine" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="2dp"
            android:layout_weight="1"
            android:gravity="top"
            android:orientation="horizontal" >

            <TextView
                android:id="@+id/widget_main_active_progress"
                style="@style/WidgetSecondaryText"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/workout_widget_preview_progress" />

            <Chronometer
                android:id="@+id/widget_main_active_timer"
                style="@style/WidgetTimerText"
                android:layout_width="wrap_content"
                android:gravity="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_main_continue"
            style="@style/WidgetActionText"
            android:text="@string/workout_widget_continue" />
    </LinearLayout>
</FrameLayout>
